{
    "ws_url": "ws://127.0.0.1:9527",
    "device_name": "Rust Controller",
    "video": {
        "decoder": "auto",
        "enable_hardware_decode": true,
        "enable_d3d11_video": true,
        "num_decode_threads": 4
    },
    "render": {
        "vsync": false,
        "low_latency_mode": true,
        "max_frame_latency": 1,
