[Unit]
Description=MRD root coturn control socket

[Socket]
ListenStream=/run/mrd-relay-coturn-control/control.sock
FileDescriptorName=mrd-relay-coturn-control
SocketUser=root
SocketGroup=mrd-relay
SocketMode=0660
DirectoryMode=0750
Accept=yes
RemoveOnStop=yes
MaxConnections=16
MaxConnectionsPerSource=4
TriggerLimitIntervalSec=30s
# Each bounded snapshot/probe is a separate authenticated socket activation.
# Allow the supervisor, five-second heartbeat, and verifier to coexist while
# retaining per-source concurrency and a finite total activation budget.
TriggerLimitBurst=256

[Install]
WantedBy=sockets.target
