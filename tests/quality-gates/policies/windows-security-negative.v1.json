{
  "id": "windows-security-negative.v1",
  "required_scenarios": [
    "security.negative.untrusted",
    "security.negative.replay",
    "security.negative.revoked",
    "security.negative.wrong_scope",
    "security.negative.certificate_substitution"
  ],
  "allow_skips": [],
  "thresholds": [],
  "security_negative_requirements": {
    "attempts": [
      {"scenario": "security.negative.untrusted", "attempt_kind": "untrusted", "rejection_reason": "trust_required"},
      {"scenario": "security.negative.replay", "attempt_kind": "replay", "rejection_reason": "replay_detected"},
      {"scenario": "security.negative.revoked", "attempt_kind": "revoked", "rejection_reason": "grant_revoked"},
      {"scenario": "security.negative.wrong_scope", "attempt_kind": "wrong_scope", "rejection_reason": "scope_denied"},
      {"scenario": "security.negative.certificate_substitution", "attempt_kind": "certificate_substitution", "rejection_reason": "certificate_binding_mismatch"}
    ],
    "require_rejected": true,
    "max_sender_tasks_started": 0,
    "max_receiver_tasks_started": 0,
    "max_media_packets_sent": 0,
    "max_media_frames_presented": 0,
    "max_control_events_injected": 0,
    "require_cleanup_completed": true,
    "min_audit_events": 1
  }
}
