{
  "duration_sec": 60,
  "thresholds": {
    "control_connect_timeout_sec": 20,
    "min_frames": {
      "webrtc": 20,
      "quic": 20,
      "webtransport": 10
    },
    "jitter": {
      "p95_ms_max": 80.0,
      "p99_ms_max": 200.0,
      "gt_100ms_max": 20,
      "gt_200ms_max": 5
    },
    "agent_errors_max": 10,
    "agent_quic_drop_max": 5000,
    "diag": {
      "ffmpeg_restart_max": 2,
      "roi_effectiveness_min": 0.8
    }
  },
  "analysis": {
    "controller_codecs": [
      "av1",
      "h264"
    ],
    "capture_patch": {
      "codecPolicy": {
        "force": "av1"
      },
      "qualityPolicy": {
        "roi": {
          "enable": true,
          "rect": {
            "x": 0.3,
            "y": 0.3,
            "w": 0.4,
            "h": 0.4
          },
          "qoffset": -0.125
        }
      }
    },
    "agent_env": {
      "AGENT_NVENC_NATIVE_ROI_ENABLE": "0"
    }
  }
}