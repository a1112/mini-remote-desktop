{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-remote-desktop.local/schemas/benchmark-result.schema.json",
  "title": "BenchmarkSummary",
  "type": "object",
  "required": [
    "run_id",
    "scenario",
    "transport",
    "capture_backend",
    "encode_backend",
    "decode_backend",
    "renderer_backend",
    "width",
    "height",
    "fps_target",
    "duration_secs",
    "session_established",
    "first_frame_seen",
    "probe_complete",
    "fps_observed",
    "bitrate_kbps",
    "keyframes",
    "dropped_frames",
    "zero_write_access_unit_count",
    "warning_count",
    "error_count",
    "restart_count",
    "failure_reason",
    "run_passed"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "scenario": { "type": "string" },
    "transport": { "type": "string" },
    "capture_backend": { "type": "string" },
    "encode_backend": { "type": "string" },
    "decode_backend": { "type": "string" },
    "renderer_backend": { "type": "string" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "fps_target": { "type": "integer", "minimum": 1 },
    "duration_secs": { "type": "integer", "minimum": 1 },
    "session_established": { "type": "boolean" },
    "first_frame_seen": { "type": "boolean" },
    "first_frame_time_ms": { "type": ["number", "null"] },
    "probe_complete": { "type": "boolean" },
    "fps_observed": { "type": "number" },
    "bitrate_kbps": { "type": "number" },
    "keyframes": { "type": "integer", "minimum": 0 },
    "dropped_frames": { "type": "integer", "minimum": 0 },
    "quic_receiver_completed_frames": { "type": ["integer", "null"], "minimum": 0 },
    "quic_receiver_expired_frames": { "type": ["integer", "null"], "minimum": 0 },
    "quic_receiver_evicted_frames": { "type": ["integer", "null"], "minimum": 0 },
    "quic_receiver_duplicate_fragments": { "type": ["integer", "null"], "minimum": 0 },
    "quic_receiver_rejected_fragments": { "type": ["integer", "null"], "minimum": 0 },
    "quic_receiver_pending_frames": { "type": ["integer", "null"], "minimum": 0 },
    "quic_receiver_reassembly_drops": { "type": ["integer", "null"], "minimum": 0 },
    "zero_write_access_unit_count": { "type": "integer", "minimum": 0 },
    "warning_count": { "type": "integer", "minimum": 0 },
    "error_count": { "type": "integer", "minimum": 0 },
    "restart_count": { "type": "integer", "minimum": 0 },
    "failure_reason": { "type": ["string", "null"] },
    "encode_total_p95_ms": { "type": ["number", "null"] },
    "send_write_p95_ms": { "type": ["number", "null"] },
    "decode_total_p95_ms": { "type": ["number", "null"] },
    "frame_sink_ingest_p95_ms": { "type": ["number", "null"] },
    "render_upload_p95_ms": { "type": ["number", "null"] },
    "render_present_p95_ms": { "type": ["number", "null"] },
    "run_passed": { "type": "boolean" }
  },
  "additionalProperties": false
}
