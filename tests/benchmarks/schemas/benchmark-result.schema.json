{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mini-remote-desktop.local/schemas/benchmark-result.schema.json",
  "title": "BenchmarkSummary",
  "type": "object",
  "required": [
    "run_id",
    "scenario",
    "transport",
    "capture_backend",
    "encode_backend",
    "decode_backend",
    "renderer_backend",
    "width",
    "height",
    "fps_target",
    "duration_secs",
    "session_established",
    "first_frame_seen",
    "probe_complete",
    "fps_observed",
    "bitrate_kbps",
    "keyframes",
    "dropped_frames",
    "zero_write_access_unit_count",
    "warning_count",
    "error_count",
    "restart_count",
    "failure_reason",
    "run_skipped",
    "run_passed"
  ],
  "properties": {
    "run_id": { "type": "string" },
    "scenario": { "type": "string" },
    "transport": { "type": "string" },
    "capture_backend": { "type": "string" },
    "encode_backend": { "type": "string" },
    "decode_backend": { "type": "string" },
    "renderer_backend": { "type": "string" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "fps_target": { "type": "integer", "minimum": 1 },
    "duration_secs": { "type": "integer", "minimum": 1 },
    "session_established": { "type": "boolean" },
    "first_frame_seen": { "type": "boolean" },
    "first_frame_time_ms": { "type": ["number", "null"] },
    "probe_complete": { "type": "boolean" },
    "fps_observed": { "type": "number" },
    "bitrate_kbps": { "type": "number" },
    "keyframes": { "type": "integer", "minimum": 0 },
    "dropped_frames": { "type": "integer", "minimum": 0 },
    "quic_receiver_completed_frames": { "type": ["integer", "null"], "minimum": 0 },
    "quic_receiver_expired_frames": { "type": ["integer", "null"], "minimum": 0 },
    "quic_receiver_evicted_frames": { "type": ["integer", "null"], "minimum": 0 },
    "quic_receiver_duplicate_fragments": { "type": ["integer", "null"], "minimum": 0 },
    "quic_receiver_rejected_fragments": { "type": ["integer", "null"], "minimum": 0 },
    "quic_receiver_pending_frames": { "type": ["integer", "null"], "minimum": 0 },
    "quic_receiver_reassembly_drops": { "type": ["integer", "null"], "minimum": 0 },
    "zero_write_access_unit_count": { "type": "integer", "minimum": 0 },
    "warning_count": { "type": "integer", "minimum": 0 },
    "error_count": { "type": "integer", "minimum": 0 },
    "restart_count": { "type": "integer", "minimum": 0 },
    "failure_reason": { "type": ["string", "null"] },
    "encode_total_p95_ms": { "type": ["number", "null"] },
    "send_write_p95_ms": { "type": ["number", "null"] },
    "decode_total_p95_ms": { "type": ["number", "null"] },
    "frame_sink_ingest_p95_ms": { "type": ["number", "null"] },
    "render_upload_p95_ms": { "type": ["number", "null"] },
    "render_submit_wait_p95_ms": { "type": ["number", "null"] },
    "render_execute_p95_ms": { "type": ["number", "null"] },
    "render_prepare_wait_p95_ms": { "type": ["number", "null"] },
    "render_shared_resource_p95_ms": { "type": ["number", "null"] },
    "render_draw_present_p95_ms": { "type": ["number", "null"] },
    "render_present_p95_ms": { "type": ["number", "null"] },
    "render_submitted_frames": { "type": ["integer", "null"], "minimum": 0 },
    "render_uploaded_frames": { "type": ["integer", "null"], "minimum": 0 },
    "render_presented_frames": { "type": ["integer", "null"], "minimum": 0 },
    "render_present_skipped_frames": { "type": ["integer", "null"], "minimum": 0 },
    "render_queue_replacements": { "type": ["integer", "null"], "minimum": 0 },
    "render_stale_frame_drops": { "type": ["integer", "null"], "minimum": 0 },
    "render_queue_replacement_rate": { "type": ["number", "null"] },
    "render_stale_frame_drop_rate": { "type": ["number", "null"] },
    "render_present_skipped_rate": { "type": ["number", "null"] },
    "swap_chain_max_frame_latency": { "type": ["integer", "null"], "minimum": 1 },
    "swap_chain_allow_tearing": { "type": ["boolean", "null"] },
    "swap_chain_waitable_object": { "type": ["boolean", "null"] },
    "swap_chain_present_mode": { "type": ["string", "null"] },
    "display_refresh_hz": { "type": ["integer", "null"], "minimum": 1 },
    "render_thread_priority": { "type": ["string", "null"] },
    "nvdec_runtime_summary": { "type": "string" },
    "nvdec_h264_capability": { "type": "string" },
    "nvdec_hevc_capability": { "type": "string" },
    "nvdec_hevc_main10_capability": { "type": "string" },
    "run_status": { "type": "string", "enum": ["PASS", "FAIL", "SKIP"] },
    "run_skipped": { "type": "boolean" },
    "run_passed": { "type": "boolean" }
  },
  "additionalProperties": false
}
