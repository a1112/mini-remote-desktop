# Production startup fails closed until DB and JWT values are replaced.
RDESK_ENVIRONMENT=production
RDESK_SERVER_HOST=127.0.0.1
RDESK_SERVER_PORT=9530
RDESK_DB_URL=postgresql+asyncpg://rdesk:replace-me@127.0.0.1:5432/rdesk_server
RDESK_JWT_SECRET=replace-with-at-least-32-random-bytes
RDESK_JWT_EXPIRE_MINUTES=60

RDESK_SIGNALING_WS_URL=ws://127.0.0.1:9542/ws
RDESK_REALTIME_SERVER_HEALTH_URL=http://127.0.0.1:9542/health
RDESK_REALTIME_SERVER_COMMAND=cargo
RDESK_REALTIME_SERVER_ARGS=run -p realtime-server
RDESK_REALTIME_SERVER_WORKDIR=.
RDESK_CORS_ORIGINS=http://localhost:9531,http://127.0.0.1:9531
RDESK_DEVELOPMENT_RELOAD=false

# Optional one-time bootstrap. Configure all three values together.
# RDESK_INITIAL_ADMIN_USERNAME=admin
# RDESK_INITIAL_ADMIN_EMAIL=admin@example.com
# RDESK_INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password
RDESK_SEED_DEMO_DATA=false
